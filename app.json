{
  "expo": {
    "name": "Hoy Salgo",
    "slug": "saliofinde",
    "version": "1.0.0",
    "scheme": "saliofinde",
    "orientation": "portrait",
    "icon": "./assets/hoy-salgo-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jorgesalsamendi.hoysalgo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "saliofinde",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#100A20",
        "foregroundImage": "./assets/hoy-salgo-foreground.png",
        "monochromeImage": "./assets/hoy-salgo-monochrome.png"
      },
      "package": "com.jorgesalsamendi.hoysalgo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hoy Salgo usa tu ubicación aproximada solo cuando pedís eventos cerca tuyo."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Hoy Salgo usa el micrófono solo cuando tocás el botón para dictar tu consulta al asistente.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a63588ce-1530-4cf0-a00b-9f2176b42d68"
      }
    }
  }
}
